<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for Developer ID builds (hardened runtime). V8 needs JIT, and
  the server's utility process runs V8 and WebAssembly (the local database).
  Raven loads no third-party native code, so library validation stays on.
  Ad-hoc builds don't use this file: scripts/build.ts passes it only when
  signing, so they keep electron-builder's default entitlements.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
