# Required in production (32+ chars) — encrypts the mail session cookie (AES-256-GCM).
# The app refuses to start sessions in production without it.
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# Optional: TypeSafe Jev key. Powers Ask Jev planning/ranking and on-demand
# "Deep triage". Without it everything falls back to free local heuristics.
# Keys: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Pin the model in production so behaviour doesn't shift under you.
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Set to "false" only for self-signed IMAP/SMTP certificates (local mail servers).
IMAP_REJECT_UNAUTHORIZED=true
SMTP_REJECT_UNAUTHORIZED=true

# Production blocks custom IMAP/SMTP hosts that resolve to private networks.
# Opt in for Proton Bridge (loopback) or a mail server on your LAN.
# ALLOW_LOOPBACK_MAIL_HOSTS=true
# ALLOW_PRIVATE_MAIL_HOSTS=true

# Integrations (Slack, Discord, webhooks, mailbox export) persist in Postgres.
# Neon: `neon env pull` writes both. The app uses the pooled URL; migrations
# (`bun run db:migrate`) use the direct one. Without it the Integrations tab
# still runs the mail/Jev health checks, and asks you to connect a database.
DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Optional: key for sealing stored webhook URLs (32+ chars). Defaults to
# SESSION_SECRET; set it so rotating the session secret doesn't disconnect them.
# INTEGRATIONS_SECRET=

# Public origin of this deployment: canonical, Open Graph and sitemap URLs, and
# "Open in Raven" links inside shared messages. Without it, shared links use the
# request's own origin and page metadata uses Vercel's production URL, then
# localhost.
# APP_URL=https://mail.example.com

# Where this deployment's source code lives, shown in Settings → About and the
# landing footer. Raven is AGPL-3.0: if you run a modified copy for others,
# point this at your fork.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/you/raven-mail

# Search engines may index this deployment only when this is "true". Leave it
# unset on self-hosted copies: they all serve the same landing page, and a
# personal /login shouldn't be searchable.
# SEO_INDEX=true

# Production blocks webhook URLs that resolve to private networks.
# Opt in for a self-hosted n8n/Zapier-alike on your LAN.
# ALLOW_PRIVATE_WEBHOOK_HOSTS=true

# Welcome-tour narration, used only by `bun run tour:audio` on a dev machine.
# The clips are committed to public/tour/; the running app never calls these.
# US accent = ElevenLabs, GB accent = Mistral Voxtral.
# ELEVEN_LABS=
# MISTRAL_API_KEY=
